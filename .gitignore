# Ephemeral / local work (see work/README.md)
/work/*
!/work/.gitkeep
!/work/README.md

# Throwaway consumer scaffold trials (see playground/README.md)
/playground/*
!/playground/.gitkeep
!/playground/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.conda/

# OS / IDE
.DS_Store
.idea/
.vscode/

# AI / agents — IDE state, including this repository's own Cursor rules
.cursor/
.claude/
CLAUDE.local.md
CLAUDE.*.local.md

# Other common agent artifacts (conservative)
.aider*
.continue/
.cody/
.windsurf/
.roo/
agent-transcripts/
sample-apps/
/playground-dev/

# Development-process notes and tools: kept on disk, never committed
/docs/design-notes/
/scripts/census/
/scripts/review_effort_study.py

# Derived indexes for `specy-road history` and `specy-road search`. Rebuilt
# from git and the working tree on demand, so never committed;
# .specyrd/manifest.json stays tracked.
#
# The unanchored form matters here and not in a consumer repo: a consumer has
# one project at (or under) its git root, while this checkout also holds the
# dogfood fixture, which builds its own cache when a command runs against it.
.specyrd/cache/
**/.specyrd/cache/

# >>> specy-road managed block — do not edit inside <<<
# Written by specy-road at run time, never committed: derived caches for
# `history`, `search` and `brainstorm`; everything under work/ (briefs,
# summaries, session files, review records, chore records, session, worker
# and worktree state) except its README.md, .gitkeep and *.template.md
# scaffold; per-checkout orchestration availability overlay; per-clone
# decisions overlay. Re-include other work/ paths below the block.
# Also never committed: .specyrd/AGENTS.local.md, your personal addendum to
# specy-road's agent rules. `.specyrd/manifest.json`, when present, stays tracked.
sr/.specyrd/cache/
sr/work/*
!sr/work/README.md
!sr/work/.gitkeep
!sr/work/*.template.md
sr/roadmap/orchestration.local.yaml
sr/roadmap/decisions.local.yaml
sr/.specyrd/AGENTS.local.md
# >>> end specy-road managed block <<<
