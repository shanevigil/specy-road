# Session-scoped work artifacts created by specy-road do-next-available-task.
# These are regenerated each pickup; tracking them adds noise to feature
# branches. Briefs (work/brief-*.md) and implementation summaries
# (work/implementation-summary-*.md) are intentionally NOT ignored — they
# document the work and belong on the feature branch.
#
# work/pr-body-*.md is the finish-this-task snapshot passed to
# `gh pr create --body-file`. It is a concatenation of the brief and the
# implementation summary, so tracking it duplicates both in git history.
work/.on-complete-*.yaml
work/prompt-*.md
work/pr-body-*.md
work/.milestone-session.yaml

# Derived roadmap-history index (see docs/roadmap-history.md). Rebuilt from git
# on demand, so it is never committed; .specyrd/manifest.json stays tracked.
.specyrd/cache/
