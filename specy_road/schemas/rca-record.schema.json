{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specy-road.local/schemas/rca-record.schema.json",
  "title": "specy-road review-loop root-cause analysis record",
  "description": "YAML front matter of work/reviews/<NODE_ID>/RCA-<round>.md: why a leaf's review loop stopped converging and the cheapest corrective action. Written by the analyst `specy-road prompt <NODE_ID> --role rca` addresses; see docs/design-notes/review-loop-rca.md.",
  "type": "object",
  "required": ["node_id", "model", "date", "trigger", "classification", "evidence", "recommended_action"],
  "additionalProperties": false,
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "The analyst's roster id." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "trigger": {
      "type": "object",
      "required": ["rule", "round"],
      "additionalProperties": false,
      "properties": {
        "rule": { "enum": ["same_acceptance", "review_rounds"] },
        "acceptance_ids": { "type": "array", "items": { "$ref": "#/$defs/acceptanceId" } },
        "round": { "type": "integer", "minimum": 1, "description": "Review rounds in the history when the prompt was built, as the prompt names it; the record resolves every round up to it. A round beyond the history makes the record invalid." }
      }
    },
    "classification": {
      "type": "object",
      "required": ["primary", "confidence"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/rcaClass" },
        "secondary": { "$ref": "#/$defs/rcaClass" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref", "note"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["finding", "commit", "acceptance", "signal", "check_result"] },
          "ref": { "type": "string", "minLength": 1, "description": "Round and reviewer of a finding, a commit SHA, an acceptance id, or a check name." },
          "supports": { "enum": ["primary", "secondary", "against"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommended_action": {
      "type": "object",
      "required": ["type", "instructions", "requires_human_approval"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["amend_criterion", "split_leaf", "continue_with_class_fix", "restart_executor_fresh",
                   "fix_tests", "change_or_reprompt_reviewer", "fix_environment", "escalate_human"]
        },
        "instructions": { "type": "string", "minLength": 1 },
        "requires_human_approval": { "type": "boolean" }
      }
    },
    "criterion_rewrite": {
      "type": "object",
      "required": ["acceptance_id", "original_text", "proposed_text", "finding_disposition"],
      "additionalProperties": false,
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/acceptanceId" },
        "original_text": { "type": "string", "minLength": 1 },
        "proposed_text": { "type": "string", "minLength": 1 },
        "finding_disposition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding", "label"],
            "additionalProperties": false,
            "properties": {
              "finding": { "type": "string", "minLength": 1 },
              "label": { "enum": ["in_scope_must_fix", "out_of_scope_now", "already_resolved"] },
              "justification": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "if": {
    "required": ["classification"],
    "properties": { "classification": { "required": ["primary"], "properties": { "primary": { "const": "specification" } } } }
  },
  "then": { "required": ["criterion_rewrite"] },
  "$defs": {
    "acceptanceId": { "type": "string", "pattern": "^A[1-9][0-9]*$" },
    "rcaClass": { "enum": ["specification", "implementation", "test", "reviewer", "environment", "hard_problem"] }
  }
}
