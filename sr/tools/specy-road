#!/bin/sh
# specy-road from the WIP/improvements-0-3-1 checkout (the toolkit's own integration line).
# Workers and reviewers put this directory first on PATH so bookkeeping commands run the
# line under development rather than whatever version the shell has installed.
. "$(dirname "$0")/env.sh"
PYTHONPATH=$ROOT exec "$PY" -m specy_road.cli "$@"
